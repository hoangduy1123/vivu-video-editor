# Quản lý lưu trữ lịch sử & Dự án (Local Storage & Project Saver)
# ---------------------------------------------------------------------------

class ProjectStorageManager:
    def __init__(self, db_file="catcat_history.db"):
        self.db_file = db_file
        self.init_db()

    def init_db(self):
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS export_history (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                file_name TEXT,
                file_path TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        conn.commit()
        conn.close()

    def add_history(self, file_path):
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute("INSERT INTO export_history (file_name, file_path) VALUES (?, ?)", 
                       (os.path.basename(file_path), file_path))
        conn.commit()
        conn.close()

    def get_history(self):
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute("SELECT file_name, file_path, created_at FROM export_history ORDER BY id DESC")
        rows = cursor.fetchall()
        conn.close()
        return rows


# ---------------------------------------------------------------------------
# Workers (Xử lý Đa luồng: Ghép ảnh, Lồng tiếng, Render FFmpeg)
# ---------------------------------------------------------------------------

class OfflineVoiceThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, text, rate=150):
        super().__init__()
        self.text = text
        self.rate = rate

    def run(self):
        try:
            engine = pyttsx3.init()
            engine.setProperty('rate', self.rate)
            out_path = "temp_voice.wav"
            engine.save_to_file(self.text, out_path)
            engine.runAndWait()
            self.finished.emit(out_path)
        except Exception as e:
            self.error.emit(str(e))

class RenderFFmpegThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, video_path, image_overlay, audio_path, start, dur, bg_mode, out_path):
        super().__init__()
        self.video_path = video_path
        self.image_overlay = image_overlay
        self.audio_path = audio_path
        self.start = start
        self.dur = dur
        self.bg_mode = bg_mode
        self.out_path = out_path

    def run(self):
        try:
            cmd = ['ffmpeg', '-y']
            if self.start:
                cmd.extend(['-ss', str(self.start)])
            if self.dur:
                cmd.extend(['-t', str(self.dur)])

            cmd.extend(['-i', self.video_path])

            # Nếu có chèn ảnh đè lên video
            if self.image_overlay and os.path.exists(self.image_overlay):
                cmd.extend(['-i', self.image_overlay])

            # Nếu có chèn giọng đọc AI / Audio
            if self.audio_path and os.path.exists(self.audio_path):
                cmd.extend(['-i', self.audio_path])

            # Xử lý ghép ảnh đè (Overlay) & Xoá phông
            filter_complex = []
            if self.image_overlay and os.path.exists(self.image_overlay):
                filter_complex.append("[0:v][1:v]overlay=10:10[v_out]")

            if "Xoá phông xanh (Chroma Key)" in self.bg_mode:
                if filter_complex:
                    filter_complex.append("[v_out]chromakey=0x00FF00:0.1:0.1[v_out]")
                else:
                    filter_complex.append("[0:v]chromakey=0x00FF00:0.1:0.1[v_out]")

            if filter_complex:
                cmd.extend(['-filter_complex', ';'.join(filter_complex), '-map', '[v_out]'])
            
            # Map Audio
            if self.audio_path and os.path.exists(self.audio_path):
                audio_idx = 2 if (self.image_overlay and os.path.exists(self.image_overlay)) else 1
                cmd.extend(['-map', f'{audio_idx}:a:0', '-c:a', 'aac'])
            else:
                cmd.extend(['-c:a', 'aac'])

            cmd.extend(['-c:v', 'libx264', self.out_path])

            proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if proc.returncode == 0:
                self.finished.emit(self.out_path)
            else:
                self.error.emit(proc.stderr.decode('utf-8'))
        except Exception as e:
            self.error.emit(str(e))


