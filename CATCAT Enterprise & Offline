    def add_video_file(self):
        f, _ = QFileDialog.getOpenFileName(self, "Chọn Video", "", "Video Files (*.mp4 *.mkv *.avi)")
        if f:
            self.current_video = f
            self.player.setSource(QUrl.fromLocalFile(f))
            self.media_list.addItem(f"Video: {f}")
            self.lbl_status.setText(f"Đã chọn video: {os.path.basename(f)}")

    def add_image_file(self):
        f, _ = QFileDialog.getOpenFileName(self, "Chọn Ảnh Ghép", "", "Image Files (*.png *.jpg *.jpeg)")
        if f:
            self.current_image = f
            self.lbl_image_status.setText(f"Ảnh chèn: {os.path.basename(f)}")
            self.media_list.addItem(f"Ảnh: {f}")
            QMessageBox.information(self, "Thành công", f"Đã chọn ảnh '{os.path.basename(f)}' để ghép đè lên video!")

    def on_media_double_click(self, item):
        path = item.text().split(": ")[-1]
        if os.path.exists(path) and path.endswith(('.mp4', '.mkv', '.avi')):
            self.current_video = path
            self.player.setSource(QUrl.fromLocalFile(path))

    def generate_voice(self):
        text = self.txt_script.toPlainText().strip()
        if not text:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập kịch bản!")
            return
        speed_str = self.cbo_voice_speed.currentText()
        rate = 180 if "Nhanh" in speed_str else (120 if "Chậm" in speed_str else 150)

        self.lbl_status.setText("Đang tạo giọng đọc AI...")
        self.v_thread = OfflineVoiceThread(text, rate)
        self.v_thread.finished.connect(self.on_voice_done)
        self.v_thread.start()

    def on_voice_done(self, out_path):
        self.current_audio = out_path
        self.lbl_status.setText("Tạo giọng đọc AI thành công!")
        QMessageBox.information(self, "Thành công", "Đã tạo giọng đọc AI thành công và chuẩn bị ghép vào video!")

    def toggle_play(self):
        if self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.player.pause()
        else:
            self.player.play()

    def save_project(self):
        data = {
            "video": self.current_video,
            "image": self.current_image,
            "audio": self.current_audio,
            "script": self.txt_script.toPlainText()
        }
        f, _ = QFileDialog.getSaveFileName(self, "Lưu Dự Án", "my_project.catcat", "CATCAT Project (*.catcat)")
        if f:
            with open(f, "w", encoding="utf-8") as file:
                json.dump(data, file, ensure_ascii=False, indent=4)
            QMessageBox.information(self, "Thành công", "Đã lưu dự án thành công!")

    def load_project(self):
        f, _ = QFileDialog.getOpenFileName(self, "Mở Dự Án", "", "CATCAT Project (*.catcat)")
        if f and os.path.exists(f):
            with open(f, "r", encoding="utf-8") as file:
                data = json.load(file)
                self.current_video = data.get("video", "")
                self.current_image = data.get("image", "")
                self.current_audio = data.get("audio", "")
                self.txt_script.setPlainText(data.get("script", ""))
                if self.current_video:
                    self.player.setSource(QUrl.fromLocalFile(self.current_video))
                if self.current_image:
                    self.lbl_image_status.setText(f"Ảnh chèn: {os.path.basename(self.current_image)}")
            QMessageBox.information(self, "Thành công", "Đã tải dự án thành công!")

    def refresh_history(self):
        self.history_list.clear()
        for name, path, dt in self.storage.get_history():
            self.history_list.addItem(f"{name} ({dt}) -> {path}")

    def export_video(self):
        if not self.current_video:
            QMessageBox.warning(self, "Cảnh báo", "Chưa chọn video nguồn!")
            return
        out_path, _ = QFileDialog.getSaveFileName(self, "Lưu Video Xuất", "catcat_final.mp4", "MP4 (*.mp4)")
        if not out_path:
            return

        start = self.txt_start.text().strip()
        dur = self.txt_dur.text().strip()
        bg_mode = self.cbo_bg.currentText()

        self.lbl_status.setText("Đang xuất video qua FFmpeg Engine...")
        self.render_thread = RenderFFmpegThread(
            self.current_video, self.current_image, self.current_audio,
            start, dur, bg_mode, out_path
        )
        self.render_thread.finished.connect(self.on_export_done)
        self.render_thread.error.connect(lambda e: QMessageBox.critical(self, "Lỗi", f"Chi tiết lỗi:\n{e}"))
        self.render_thread.start()

    def on_export_done(self, out_path):
        self.storage.add_history(out_path)
        self.refresh_history()
        self.lbl_status.setText("Xuất video thành công!")
        QMessageBox.information(self, "Thành công", f"Video hoàn chỉnh đã được lưu tại:\n{out_path}")

