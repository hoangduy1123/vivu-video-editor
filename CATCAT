    # ---------------------------------------------------------------------------
    # Logic Xử Lý Tính Năng
    # ---------------------------------------------------------------------------

    def browse_video(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "Chọn tệp Video", "", "Video Files (*.mp4 *.avi *.mkv *.mov)")
        if file_path:
            self.load_video(file_path)

    def load_video(self, file_path):
        self.current_video_path = file_path
        self.media_player.setSource(QUrl.fromLocalFile(file_path))
        self.status_label.setText(f"Đã nạp video: {os.path.basename(file_path)}")
        
        # Thêm vào danh sách Media nếu chưa có
        items = [self.media_list.item(i).text() for i in range(self.media_list.count())]
        if file_path not in items:
            self.media_list.addItem(file_path)

    def select_media_from_list(self, item):
        self.load_video(item.text())

    def download_online_video(self):
        url = self.url_input.text().strip()
        if not url:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập URL video!")
            return

        self.status_label.setText("Đang tải video từ internet...")
        self.dl_thread = VideoDownloadThread(url)
        self.dl_thread.finished.connect(self.on_download_finished)
        self.dl_thread.error.connect(self.show_error)
        self.dl_thread.start()

    def on_download_finished(self, file_path):
        self.status_label.setText("Tải video thành công!")
        self.load_video(file_path)

    def generate_tts(self):
        text = self.tts_text.toPlainText().strip()
        if not text:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập văn bản!")
            return

        lang_code = self.tts_lang_combo.currentText().split("(")[-1].replace(")", "").strip()
        self.status_label.setText("Đang tạo giọng đọc AI...")

        self.tts_thread = TTSThread(text, lang_code)
        self.tts_thread.finished.connect(self.on_tts_finished)
        self.tts_thread.error.connect(self.show_error)
        self.tts_thread.start()

    def on_tts_finished(self, audio_path):
        self.current_audio_path = audio_path
        self.status_label.setText("Tạo giọng đọc AI thành công! Đã gắn vào video.")
        QMessageBox.information(self, "Thông báo", "Giọng đọc AI đã tạo thành công và sẵn sàng để ghép vào video khi xuất!")

    def translate_text(self):
        text = self.trans_src_text.toPlainText().strip()
        if not text:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập văn bản gốc!")
            return

        lang_code = self.trans_lang_combo.currentText().split("(")[-1].replace(")", "").strip()
        self.status_label.setText("Đang dịch thuật...")

        self.trans_thread = TranslationThread(text, lang_code)
        self.trans_thread.finished.connect(self.on_trans_finished)
        self.trans_thread.error.connect(self.show_error)
        self.trans_thread.start()

    def on_trans_finished(self, translated_text):
        self.trans_out_text.setPlainText(translated_text)
        self.status_label.setText("Dịch thuật hoàn tất!")

    def toggle_play(self):
        if self.media_player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.media_player.pause()
            self.btn_play.setText("▶ Play")
        else:
            self.media_player.play()
            self.btn_play.setText("⏸ Pause")

    def export_video(self):
        if not self.current_video_path or not os.path.exists(self.current_video_path):
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập video trước khi xuất!")
            return

        save_path, _ = QFileDialog.getSaveFileName(self, "Lưu Video", "catcat_output.mp4", "MP4 Files (*.mp4)")
        if not save_path:
            return

        start_time = self.start_time_input.text().strip()
        duration = self.duration_input.text().strip()

        self.status_label.setText("Đang xuất video bằng FFmpeg...")
        self.export_thread = ExportVideoThread(
            self.current_video_path, self.current_audio_path, save_path, start_time, duration
        )
        self.export_thread.finished.connect(self.on_export_finished)
        self.export_thread.error.connect(self.show_error)
        self.export_thread.start()

    def on_export_finished(self, out_path):
        self.status_label.setText("Xuất video thành công!")
        QMessageBox.information(self, "Thành công", f"Video đã xuất thành công tại:\n{out_path}")

    def show_error(self, err_msg):
        self.status_label.setText("Xảy ra lỗi!")
        QMessageBox.critical(self, "Lỗi", f"Đã xảy ra lỗi trong quá trình xử lý:\n{err_msg}")

