# ---------------------------------------------------------------------------
# Worker Threads (Xử lý bất đồng bộ để tránh treo giao diện UI)
# ---------------------------------------------------------------------------

class VideoDownloadThread(QThread):
    progress = pyqtSignal(str)
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, url, output_dir="downloads"):
        super().__init__()
        self.url = url
        self.output_dir = output_dir

    def run(self):
        try:
            if not os.path.exists(self.output_dir):
                os.makedirs(self.output_dir)
            
            out_template = os.path.join(self.output_dir, '%(title)s.%(ext)s')
            ydl_opts = {
                'format': 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best',
                'outtmpl': out_template,
                'quiet': True
            }
            self.progress.emit("Đang kết nối và tải video...")
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(self.url, download=True)
                filename = ydl.prepare_filename(info)
                self.finished.emit(filename)
        except Exception as e:
            self.error.emit(str(e))

class TTSThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, text, lang, output_path="temp_tts.mp3"):
        super().__init__()
        self.text = text
        self.lang = lang
        self.output_path = output_path

    def run(self):
        try:
            tts = gTTS(text=self.text, lang=self.lang, slow=False)
            tts.save(self.output_path)
            self.finished.emit(self.output_path)
        except Exception as e:
            self.error.emit(str(e))

class TranslationThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, text, dest_lang):
        super().__init__()
        self.text = text
        self.dest_lang = dest_lang

    def run(self):
        try:
            translator = Translator()
            res = translator.translate(self.text, dest=self.dest_lang)
            self.finished.emit(res.text)
        except Exception as e:
            self.error.emit(str(e))

class ExportVideoThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, input_video, audio_tts, output_path, start_time, duration):
        super().__init__()
        self.input_video = input_video
        self.audio_tts = audio_tts
        self.output_path = output_path
        self.start_time = start_time
        self.duration = duration

    def run(self):
        try:
            # Lệnh FFmpeg ghép audio TTS và cắt video
            cmd = ['ffmpeg', '-y']
            if self.start_time:
                cmd.extend(['-ss', str(self.start_time)])
            if self.duration:
                cmd.extend(['-t', str(self.duration)])
            
            cmd.extend(['-i', self.input_video])

            if self.audio_tts and os.path.exists(self.audio_tts):
                cmd.extend(['-i', self.audio_tts])
                cmd.extend(['-c:v', 'copy', '-c:a', 'aac', '-map', '0:v:0', '-map', '1:a:0'])
            else:
                cmd.extend(['-c', 'copy'])

            cmd.append(self.output_path)

            process = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if process.returncode == 0:
                self.finished.emit(self.output_path)
            else:
                self.error.emit(process.stderr.decode('utf-8'))
        except Exception as e:
            self.error.emit(str(e))


