    def browse_media(self):
        f, _ = QFileDialog.getOpenFileName(self, "Chọn Media", "", "Media Files (*.mp4 *.mkv *.avi *.mp3 *.wav)")
        if f:
            self.load_media(f)

    def load_media(self, path):
        if path.endswith(('.mp4', '.mkv', '.avi')):
            self.current_video_path = path
            self.media_player.setSource(QUrl.fromLocalFile(path))
            self.status_label.setText(f"Đã nạp video: {os.path.basename(path)}")
        elif path.endswith(('.mp3', '.wav')):
            self.current_audio_path = path
            self.status_label.setText(f"Đã nạp nhạc nền/audio: {os.path.basename(path)}")

        items = [self.media_list.item(i).text() for i in range(self.media_list.count())]
        if path not in items:
            self.media_list.addItem(path)

    def select_media(self, item):
        self.load_media(item.text())

    def download_video(self):
        url = self.url_input.text().strip()
        if not url:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập URL hợp lệ!")
            return
        self.status_label.setText("Đang tải video từ Internet...")
        self.dl_thread = DownloadThread(url)
        self.dl_thread.finished.connect(self.on_download_done)
        self.dl_thread.error.connect(self.show_error)
        self.dl_thread.start()

    def on_download_done(self, path):
        self.status_label.setText("Tải video thành công!")
        self.load_media(path)

    def generate_ai_voice(self):
        text = self.ai_text.toPlainText().strip()
        if not text:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập kịch bản review!")
            return
        lang = self.ai_lang_combo.currentText().split("(")[-1].replace(")", "").strip()
        style = self.voice_style_combo.currentText()

        self.status_label.setText("Đang tổng hợp giọng đọc AI Review...")
        self.ai_thread = AIReviewVoiceThread(text, lang, style)
        self.ai_thread.finished.connect(self.on_ai_voice_done)
        self.ai_thread.error.connect(self.show_error)
        self.ai_thread.start()

    def on_ai_voice_done(self, audio_path):
        self.current_audio_path = audio_path
        self.load_media(audio_path)
        self.status_label.setText("Đã tạo giọng đọc AI thành công và nạp vào dự án!")
        QMessageBox.information(self, "Thành công", "Đã tạo giọng đọc AI Review thành công! Bạn có thể xuất video để lồng tiếng.")

    def translate_content(self):
        text = self.trans_src.toPlainText().strip()
        if not text:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập văn bản cần dịch!")
            return
        dest = self.trans_dest_combo.currentText().split("(")[-1].replace(")", "").strip()
        self.status_label.setText("Đang dịch tự động...")
        self.trans_thread = TranslationThread(text, dest)
        self.trans_thread.finished.connect(lambda res: self.trans_out.setPlainText(res))
        self.trans_thread.error.connect(self.show_error)
        self.trans_thread.start()

    def toggle_play(self):
        if self.media_player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.media_player.pause()
        else:
            self.media_player.play()

    def export_video(self):
        if not self.current_video_path:
            QMessageBox.warning(self, "Cảnh báo", "Chưa có video nguồn để xuất!")
            return
        out_path, _ = QFileDialog.getSaveFileName(self, "Lưu Video Xuất Bản", "catcat_pro_output.mp4", "MP4 Files (*.mp4)")
        if not out_path:
            return

        start = self.start_input.text().strip()
        dur = self.dur_input.text().strip()
        speed = self.speed_combo.currentText()
        filt = self.filter_combo.currentText()

        self.status_label.setText("Đang render và xuất video qua FFmpeg...")
        self.export_thread = FFmpegProcessThread(
            self.current_video_path, self.current_audio_path, start, dur, speed, filt, out_path
        )
        self.export_thread.finished.connect(self.on_export_done)
        self.export_thread.error.connect(self.show_error)
        self.export_thread.start()

    def on_export_done(self, path):
        self.status_label.setText("Xuất video thành công hoàn hảo!")
        QMessageBox.information(self, "Thành công", f"Video đã được lưu tại:\n{path}")

    def show_error(self, err):
        self.status_label.setText("Lỗi xử lý!")
        QMessageBox.critical(self, "Lỗi Hệ Thống", f"Chi tiết lỗi:\n{err}")

    def apply_pro_theme(self):
        self.setStyleSheet("""
            QMainWindow, QWidget { background-color: #121212; color: #e0e0e0; font-family: 'Segoe UI', Arial; }
            QTabWidget::pane { border: 1px solid #2d2d2d; }
            QTabBar::tab { background: #1e1e1e; color: #888; padding: 10px 18px; border-top-left-radius: 6px; border-top-right-radius: 6px; }
            QTabBar::tab:selected { background: #6a1b9a; color: white; font-weight: bold; }
            QPushButton { background-color: #333333; color: white; border: none; padding: 8px 14px; border-radius: 6px; }
            QPushButton:hover { background-color: #555555; }
            QLineEdit, QTextEdit, QComboBox, QListWidget { background-color: #1a1a1a; color: #ffffff; border: 1px solid #333; border-radius: 6px; padding: 6px; }
            QGroupBox { border: 1px solid #444; border-radius: 6px; margin-top: 12px; font-weight: bold; color: #b39ddb; }
            QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }
        """)

