# Workers (Xử lý bất đồng bộ đa luồng mượt mà)
# ---------------------------------------------------------------------------

class DownloadThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, url):
        super().__init__()
        self.url = url

    def run(self):
        try:
            os.makedirs("downloads", exist_ok=True)
            ydl_opts = {
                'format': 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best',
                'outtmpl': 'downloads/%(title)s.%(ext)s',
                'quiet': True
            }
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(self.url, download=True)
                filename = ydl.prepare_filename(info)
                self.finished.emit(filename)
        except Exception as e:
            self.error.emit(str(e))

class AIReviewVoiceThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, text, lang, voice_style):
        super().__init__()
        self.text = text
        self.lang = lang
        self.voice_style = voice_style  # Kiểu giọng đọc review/thuyết minh

    def run(self):
        try:
            # Tùy biến tốc độ hoặc âm điệu dựa trên phong cách review
            slow = True if "Trầm ấm / Kể chuyện" in self.voice_style else False
            tts = gTTS(text=self.text, lang=self.lang, slow=slow)
            output_path = "temp_ai_review.mp3"
            tts.save(output_path)
            self.finished.emit(output_path)
        except Exception as e:
            self.error.emit(str(e))

class TranslationThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, text, dest_lang):
        super().__init__()
        self.text = text
        self.dest_lang = dest_lang

    def run(self):
        try:
            translator = Translator()
            res = translator.translate(self.text, dest=self.dest_lang)
            self.finished.emit(res.text)
        except Exception as e:
            self.error.emit(str(e))

class FFmpegProcessThread(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, input_video, audio_track, start_time, duration, speed_mode, filter_mode, output_path):
        super().__init__()
        self.input_video = input_video
        self.audio_track = audio_track
        self.start_time = start_time
        self.duration = duration
        self.speed_mode = speed_mode
        self.filter_mode = filter_mode
        self.output_path = output_path

    def run(self):
        try:
            cmd = ['ffmpeg', '-y']
            if self.start_time:
                cmd.extend(['-ss', str(self.start_time)])
            if self.duration:
                cmd.extend(['-t', str(self.duration)])

            cmd.extend(['-i', self.input_video])

            if self.audio_track and os.path.exists(self.audio_track):
                cmd.extend(['-i', self.audio_track])

            # Xử lý hiệu ứng video & tốc độ (Filters)
            video_filters = []
            if "Đen trắng (Grayscale)" in self.filter_mode:
                video_filters.append("format=gray")
            elif "Tăng sáng (Brightness)" in self.filter_mode:
                video_filters.append("eq=brightness=0.1")

            if "Tua nhanh 2x" in self.speed_mode:
                video_filters.append("setpts=0.5*PTS")
            elif "Chậm 0.5x (Slow-mo)" in self.speed_mode:
                video_filters.append("setpts=2.0*PTS")

            if video_filters:
                cmd.extend(['-vf', ','.join(video_filters)])

            # Mapping audio và video
            if self.audio_track and os.path.exists(self.audio_track):
                cmd.extend(['-c:v', 'libx264', '-c:a', 'aac', '-map', '0:v:0', '-map', '1:a:0'])
            else:
                cmd.extend(['-c:v', 'libx264', '-c:a', 'aac'])

            cmd.append(self.output_path)

            process = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if process.returncode == 0:
                self.finished.emit(self.output_path)
            else:
                self.error.emit(process.stderr.decode('utf-8'))
        except Exception as e:
            self.error.emit(str(e))


