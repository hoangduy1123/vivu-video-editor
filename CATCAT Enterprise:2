    def add_video(self):
        f, _ = QFileDialog.getOpenFileName(self, "Chọn Video", "", "Video Files (*.mp4 *.mkv *.avi)")
        if f:
            self.current_video = f
            self.player.setSource(QUrl.fromLocalFile(f))
            self.media_list.addItem(f"Video: {f}")
            self.lbl_status.setText(f"Đã chọn: {os.path.basename(f)}")

    def add_image(self):
        f, _ = QFileDialog.getOpenFileName(self, "Chọn Ảnh Ghép", "", "Image Files (*.png *.jpg *.jpeg)")
        if f:
            self.current_image = f
            self.lbl_image_info.setText(f"Ảnh đè: {os.path.basename(f)}")
            self.media_list.addItem(f"Ảnh: {f}")
            QMessageBox.information(self, "Thành công", f"Đã chọn ảnh '{os.path.basename(f)}' để ghép vào video!")

    def on_media_double_click(self, item):
        path = item.text().split(": ")[-1]
        if os.path.exists(path) and path.endswith(('.mp4', '.mkv', '.avi')):
            self.current_video = path
            self.player.setSource(QUrl.fromLocalFile(path))

    def generate_ai_voice(self):
        text = self.txt_script.toPlainText().strip()
        if not text:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng nhập kịch bản!")
            return
        speed_str = self.cbo_voice_speed.currentText()
        rate = 180 if "Nhanh" in speed_str else (120 if "Chậm" in speed_str else 150)

        self.lbl_status.setText("Đang tạo giọng đọc AI Offline...")
        self.worker_voice = OfflineAIVoiceWorker(text, rate)
        self.worker_voice.finished.connect(self.on_voice_done)
        self.worker_voice.start()

    def on_voice_done(self, out_path):
        self.current_audio = out_path
        self.lbl_status.setText("Tạo giọng đọc AI thành công!")
        QMessageBox.information(self, "Thành công", "Đã tạo xong giọng đọc AI và tự động nạp để ghép vào video!")

    def toggle_play(self):
        if self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.player.pause()
        else:
            self.player.play()

    def save_project(self):
        data = {
            "video": self.current_video,
            "image": self.current_image,
            "audio": self.current_audio,
            "script": self.txt_script.toPlainText()
        }
        f, _ = QFileDialog.getSaveFileName(self, "Lưu Dự Án", "project.catcat", "CATCAT Project (*.catcat)")
        if f:
            with open(f, "w", encoding="utf-8") as file:
                json.dump(data, file, ensure_ascii=False, indent=4)
            QMessageBox.information(self, "Thành công", "Đã lưu tệp dự án thành công!")

    def load_project(self):
        f, _ = QFileDialog.getOpenFileName(self, "Mở Dự Án", "", "CATCAT Project (*.catcat)")
        if f and os.path.exists(f):
            with open(f, "r", encoding="utf-8") as file:
                data = json.load(file)
                self.current_video = data.get("video", "")
                self.current_image = data.get("image", "")
                self.current_audio = data.get("audio", "")
                self.txt_script.setPlainText(data.get("script", ""))
                if self.current_video and os.path.exists(self.current_video):
                    self.player.setSource(QUrl.fromLocalFile(self.current_video))
                if self.current_image:
                    self.lbl_image_info.setText(f"Ảnh đè: {os.path.basename(self.current_image)}")
            QMessageBox.information(self, "Thành công", "Đã tải dữ liệu dự án!")

    def refresh_history(self):
        self.history_list.clear()
        for name, path, dt in self.history_mgr.get_history():
            self.history_list.addItem(f"{name} ({dt}) -> {path}")

    def export_video(self):
        if not self.current_video:
            QMessageBox.warning(self, "Cảnh báo", "Vui lòng chọn video nguồn trước!")
            return
        out_path, _ = QFileDialog.getSaveFileName(self, "Lưu Video", "catcat_output.mp4", "MP4 (*.mp4)")
        if not out_path:
            return

        start = self.txt_start.text().strip()
        dur = self.txt_dur.text().strip()
        bg_mode = self.cbo_bg.currentText()

        self.lbl_status.setText("Đang xuất video qua FFmpeg...")
        self.worker_render = FFmpegRenderWorker(
            self.current_video, self.current_image, self.current_audio,
            start, dur, bg_mode, out_path
        )
        self.worker_render.finished.connect(self.on_export_done)
        self.worker_render.error.connect(lambda e: QMessageBox.critical(self, "Lỗi", f"Chi tiết lỗi:\n{e}"))
        self.worker_render.start()

    def on_export_done(self, out_path):
        self.history_mgr.add_history(out_path)
        self.refresh_history()
        self.lbl_status.setText("Xuất video thành công!")
        QMessageBox.information(self, "Thành công", f"Video đã được lưu tại:\n{out_path}")

    def apply_capcut_theme(self):
        self.setStyleSheet("""
            QMainWindow, QWidget { background-color: #121212; color: #ffffff; font-family: 'Segoe UI', Arial; }
            QTabWidget::pane { border: 1px solid #2b2b2b; }
            QTabBar::tab { background: #1e1e1e; color: #888; padding: 8px 16px; border-top-left-radius: 4px; border-top-right-radius: 4px; }
            QTabBar::tab:selected { background: #00897b; color: white; font-weight: bold; }
            QPushButton { background-color: #26a69a; color: white; border: none; padding: 7px 12px; border-radius: 4px; font-weight: bold; }
            QPushButton:hover { background-color: #2bbd7e; }
            QLineEdit, QTextEdit, QComboBox, QListWidget { background-color: #1e1e1e; color: #ffffff; border: 1px solid #333333; border-radius: 4px; padding: 5px; }
            QGroupBox { border: 1px solid #333333; border-radius: 4px; margin-top: 10px; font-weight: bold; color: #80cbc4; }
            QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
        """)


